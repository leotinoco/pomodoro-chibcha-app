# Google OAuth (Calendar + Tasks)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Analytics (opcional)
NEXT_PUBLIC_GA_ID=

# ── Asistente de IA: cadena de 10 proveedores gratuitos ──
# Ninguna es obligatoria: el orquestador (lib/ai/orchestrator.ts) prueba cada
# una en orden y salta a la siguiente si falta la key, se agotó su cuota
# diaria (429) o falla. Con al menos una configurada, el chat funciona.
#
# Orden de intento (los primeros con soporte de imagen se priorizan cuando el
# usuario pega una foto):
GROQ_API_KEY=            # https://console.groq.com/keys
GEMINI_API_KEY=          # https://aistudio.google.com/app/apikey
OPENROUTER_API_KEY=      # https://openrouter.ai/keys (usa modelos ":free")
HUGGINGFACE_API_KEY=     # https://huggingface.co/settings/tokens
MISTRAL_API_KEY=         # https://console.mistral.ai/api-keys
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai/
TOGETHER_API_KEY=        # https://api.together.ai/settings/api-keys
DEEPSEEK_API_KEY=        # https://platform.deepseek.com/api_keys
GITHUB_MODELS_TOKEN=     # Personal Access Token con acceso a "Models" (https://github.com/settings/tokens)
COHERE_API_KEY=          # https://dashboard.cohere.com/api-keys
